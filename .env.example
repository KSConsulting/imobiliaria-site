# =====================================================================
# ImobFlow — variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores do seu projeto.
# O .env está no .gitignore e NUNCA deve ser versionado.
# =====================================================================

# ---------------------------------------------------------------------
# PÚBLICAS — com prefixo VITE_, embutidas no bundle do navegador.
# Qualquer visitante consegue lê-las. Só coloque aqui o que pode ser
# público. Quem protege os dados é o RLS do Postgres, não o segredo
# da chave.
# ---------------------------------------------------------------------

# URL do projeto Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anônima (anon / publishable key) do projeto Supabase
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANONIMA_AQUI

# O painel não exibe nada do Chatwoot, então não há variável dele aqui.
# Os identificadores de conversa continuam sendo gravados pelo N8N em
# crm_imobiliaria, para uso do atendimento — só não viram tela.

# =====================================================================
# PRIVADAS — NÃO devem existir neste arquivo nem em nenhum arquivo lido
# pelo Vite. Qualquer variável aqui com prefixo VITE_ vaza para o
# navegador.
#
# A service role key ignora todo o RLS e vive apenas nos secrets das
# Edge Functions (Etapa 9):
#
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set API_TOKEN_AGENTE_IA=...
#
# CHATWOOT_API_TOKEN e CHATWOOT_BASE_URL ficam reservados para uma futura
# integração com a API do Chatwoot. Nenhum código lê os dois hoje, então
# não há o que configurar ainda.
# =====================================================================
